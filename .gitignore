# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# secrets, credentials, and signing material
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.provisionprofile
.netrc
.npmrc.local
.dev.vars*
**/google-services.json
**/GoogleService-Info.plist
**/service-account*.json
**/client_secret*.json

# local databases and runtime state
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/dist-mobile/
/.wrangler/

# local caches and editor state
/.cache/
/.idea/
/.vscode/*.local.json
/.eslintcache
/.stylelintcache
/.turbo/
/.pytest_cache/
/.coverage
/htmlcov/
*.swp
*.swo
*.tmp
*.bak
*.orig
*.hprof
*.xcuserstate

# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
